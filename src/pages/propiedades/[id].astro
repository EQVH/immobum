---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import propertiesData from '../../data/properties.json';

export function getStaticPaths() {
  return propertiesData.map((property) => ({
    params: { id: property.id.toString() },
    props: { property },
  }));
}

const { property } = Astro.props;

// SVG Icons based on Lucide styles
const BedIcon = `<svg class="w-5 h-5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/></svg>`;
const BathIcon = `<svg class="w-5 h-5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"/><line x1="10" x2="8" y1="5" y2="7"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="7" x2="7" y1="19" y2="21"/><line x1="17" x2="17" y1="19" y2="21"/></svg>`;
const SqftIcon = `<svg class="w-5 h-5 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M7 3v18"/><path d="M17 3v18"/><path d="M3 7h18"/><path d="M3 17h18"/></svg>`;
const CheckIcon = `<svg class="w-5 h-5 text-zinc-900 mr-3 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
---

<Layout title={`${property.title} | Propiedades`} description={property.description}>
	<Header />
	<main class="pt-24 pb-24 bg-zinc-50 min-h-screen">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			
			<!-- Breadcrumbs -->
			<nav class="text-sm text-zinc-500 mb-8 mt-4">
				<a href="/" class="hover:text-zinc-900 transition-colors">Inicio</a>
				<span class="mx-2">/</span>
				<a href="/propiedades" class="hover:text-zinc-900 transition-colors">Propiedades</a>
				<span class="mx-2">/</span>
				<span class="text-zinc-900 font-medium">{property.title}</span>
			</nav>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
				
				<!-- Left Column: Gallery & Details -->
				<div class="lg:col-span-2">
					
					<!-- Gallery Carousel -->
					<div class="relative w-full aspect-[16/9] overflow-hidden rounded-2xl bg-zinc-200 mb-8">
						<div id="carousel" class="flex h-full w-full overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide">
							{property.gallery && property.gallery.map((imgUrl, index) => (
								<img 
									src={imgUrl} 
									alt={`${property.title} - Foto ${index + 1}`}
									class="flex-shrink-0 w-full h-full object-cover snap-center"
									loading={index === 0 ? "eager" : "lazy"}
								/>
							))}
						</div>
						<!-- Carousel Controls -->
						{property.gallery && property.gallery.length > 1 && (
							<div class="absolute bottom-4 left-0 right-0 flex justify-center gap-2">
								{property.gallery.map((_, index) => (
									<button 
										class="w-2.5 h-2.5 rounded-full bg-white/50 backdrop-blur-sm transition-all hover:bg-white focus:bg-white carousel-dot"
										data-index={index}
										aria-label={`Ir a la imagen ${index + 1}`}
									></button>
								))}
							</div>
						)}
					</div>

					<!-- Header Details -->
					<div class="mb-8">
						<h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-4">{property.title}</h1>
						<p class="text-xl text-zinc-600 mb-6 flex items-center">
							<svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
							{property.location}
						</p>
						<div class="flex flex-wrap gap-6 py-6 border-y border-zinc-200">
							{property.beds > 0 && (
								<div class="flex items-center gap-3">
									<div set:html={BedIcon} />
									<div>
										<p class="text-sm text-zinc-500 font-medium">Recámaras</p>
										<p class="text-lg font-bold text-zinc-900">{property.beds}</p>
									</div>
								</div>
							)}
							{property.baths > 0 && (
								<div class="flex items-center gap-3">
									<div set:html={BathIcon} />
									<div>
										<p class="text-sm text-zinc-500 font-medium">Baños</p>
										<p class="text-lg font-bold text-zinc-900">{property.baths}</p>
									</div>
								</div>
							)}
							<div class="flex items-center gap-3">
								<div set:html={SqftIcon} />
								<div>
									<p class="text-sm text-zinc-500 font-medium">Superficie</p>
									<p class="text-lg font-bold text-zinc-900">{property.sqft} m²</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Description -->
					<div class="mb-12">
						<h2 class="text-2xl font-bold text-zinc-900 mb-4">Acerca de esta propiedad</h2>
						<p class="text-lg text-zinc-600 leading-relaxed">{property.description}</p>
					</div>

					<!-- Amenities -->
					{property.amenities && property.amenities.length > 0 && (
						<div class="mb-12">
							<h2 class="text-2xl font-bold text-zinc-900 mb-6">Amenidades Principales</h2>
							<ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								{property.amenities.map(amenity => (
									<li class="flex items-start text-zinc-700 font-medium">
										<div set:html={CheckIcon} />
										{amenity}
									</li>
								))}
							</ul>
						</div>
					)}
				</div>

				<!-- Right Column: Sticky CTA Sidebar -->
				<div>
					<div class="sticky top-32 bg-white p-8 rounded-2xl border border-zinc-200 shadow-sm">
						<div class="mb-8">
							<p class="text-sm text-zinc-500 font-medium uppercase tracking-wider mb-1">Precio de venta</p>
							<p class="text-4xl font-bold text-zinc-900">{property.price}</p>
						</div>
						
						<div class="space-y-4">
							<a href="https://wa.me/523320787000" target="_blank" rel="noopener noreferrer" class="flex justify-center items-center px-6 py-4 text-base font-semibold rounded-xl text-white bg-[#25D366] hover:bg-[#20bd5a] transition-all shadow-sm w-full">
								<svg class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08c0 5-4.03 9.08-9 9.08a8.97 8.97 0 0 1-4.57-1.25L3 20l1.18-5.18c-1.12-1.63-1.78-3.6-1.78-5.74 0-5 4.03-9.08 9-9.08s9 4.07 9 9.08z"/><path d="M17 14.5c-.3-.3-.9-.6-1.2-.7-.3-.1-.6-.2-.8.1-.2.3-.8.9-1 .11-.2-.2-.5-.4-.9-.6-.6-.3-1.1-.7-1.5-1.2-.4-.5-.7-1.1-.8-1.7v-.4c.2-.2.4-.4.5-.6.1-.2.2-.4.1-.6-.1-.2-.6-1.5-.8-1.9-.2-.5-.5-.4-.8-.4h-.7c-.3 0-.7.1-1 .4-.8.8-1.2 2-1.2 3.2 0 1.2.5 2.5 1.1 3.4.6.9 1.6 1.8 2.6 2.4.9.5 2 .8 3.1.8.8 0 1.6-.2 2.3-.5.6-.3 1.2-.7 1.6-1.3.3-.5.3-1 .1-1.2z"/></svg>
								Contactar por WhatsApp
							</a>
							<a href="tel:+523353501000" class="flex justify-center items-center px-6 py-4 text-base font-semibold rounded-xl text-white bg-zinc-900 hover:bg-zinc-800 transition-all shadow-sm w-full">
								<svg class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
								Llamar al Asesor
							</a>
							<a href="mailto:contacto@immobum.com" class="flex justify-center items-center px-6 py-4 text-base font-semibold rounded-xl text-zinc-900 bg-white border-2 border-zinc-200 hover:border-zinc-900 transition-all shadow-sm w-full">
								<svg class="w-5 h-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
								Solicitar Información
							</a>
						</div>
					</div>
				</div>

			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.scrollbar-hide::-webkit-scrollbar {
		display: none;
	}
	.scrollbar-hide {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>

<script>
	// Simple script for carousel dots functionality
	document.addEventListener('DOMContentLoaded', () => {
		const carousel = document.getElementById('carousel');
		const dots = document.querySelectorAll('.carousel-dot');
		
		if (!carousel || dots.length === 0) return;

		// Initial active dot
		if (dots[0]) dots[0].classList.add('bg-white');

		// Handle dot clicks
		dots.forEach((dot, index) => {
			dot.addEventListener('click', () => {
				const scrollLeft = index * carousel.clientWidth;
				carousel.scrollTo({ left: scrollLeft, behavior: 'smooth' });
			});
		});

		// Handle scroll events to update dots
		carousel.addEventListener('scroll', () => {
			const index = Math.round(carousel.scrollLeft / carousel.clientWidth);
			dots.forEach(d => d.classList.remove('bg-white'));
			if (dots[index]) dots[index].classList.add('bg-white');
		});
	});
</script>
